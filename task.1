using System;
class Fruit
{
    public string name;
    public string taste;

    public string Name
    {
        get {return name;}
        set {name = value;}
    }

    public string Taste
    {
        get {return taste;}
        set {taste = value;}
    }

    public void Describe()
    {
        Console.WriteLine("Это фрукт");
    }
}
class Apple:Fruit
{
    public void Crunch()
    {
        Console.WriteLine("Яблоко хрустит");
    }

    public void Describe()
    {
        Console.WriteLine("Это не фрукт");
    }
}
class Orange: Fruit
{
    publci void Peel()
    {
        Console.WriteLine("Апельсин очищается");
    }

    public void Describe()
    {
        Console.WriteLine("Это тоже не фрукт");
    }
}
class Banana: Fruit
{
