using System;

public interface IMoneyAmount
{
    decimal Value { get; set; }
    void Display();
}


public abstract class MoneyAmountBase : IMoneyAmount
{
    public decimal Value { get; set; }

    protected MoneyAmountBase(decimal value)
    {
        Value = value;
    }


    public virtual void Display()
    {
        Console.WriteLine($"Сумма: {Value}");
    }
}


public class CashAmount : MoneyAmountBase
{
    public CashAmount(decimal value) : base(value) { }

    public static CashAmount operator +(CashAmount a, CashAmount b)
    {
        if (a == null || b == null) return null;
        return new CashAmount(a.Value + b.Value);
    }
}

public class BankAmount : MoneyAmountBase
{
    public BankAmount(decimal value) : base(value) { }

    public static BankAmount operator +(BankAmount a, BankAmount b)
    {
        if (a == null || b == null) return null;
        return new BankAmount(a.Value + b.Value);
    }
}


class Program
{
   
    public static void ProcessAmount(IMoneyAmount amount)
    {
        Console.Write("Обработка: ");
        amount.Display();
    }

    static void Main()
    {
       
        CashAmount cash1 = new CashAmount(500m);
        CashAmount cash2 = new CashAmount(1500m);
        
        BankAmount bank1 = new BankAmount(10000m);
        BankAmount bank2 = new BankAmount(25000.50m);

       
        CashAmount totalCash = cash1 + cash2;
        BankAmount totalBank = bank1 + bank2;

        
        Console.WriteLine("--- Вывод через общий интерфейс ---");
        ProcessAmount(cash1);
        ProcessAmount(totalCash);
        ProcessAmount(totalBank);

    }
}

